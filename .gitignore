*.password
.gitattributes
.github/
# .gitignore — this file is tracked

# ---- OS / Editor junk ----
.DS_Store
.idea/.vscode/
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
.env
.env.*
*.pyc

# ---- Node / JS tooling (if used by packages/*) ----
node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn/cache/
.yarn/install-state.gz
# keep lockfiles committed

# ---- Build / Dist / Coverage ----
build/
dist/
coverage/
htmlcov/
.venv/
*.log

# ---- Aire examples: generated outputs ----
examples/**/build/**
# common generated trace
**/trace.json

# ---- Docs build caches (if used later) ----
.site/
_site/
.sphinx/
.doctrees/
.cache/

# ---- Test caches ----
.pytest_cache/
.mypy_cache/
.coverage

# ---- Local-only exclusions ----
# Personal and not-for-distribution paths are intentionally NOT listed here.
# They are managed locally in .git/info/exclude, which is never published.
